{
  "name": "@caju/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "test": "tsx --env-file-if-exists=../../.env --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "fastify": "^5.12.3",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
